uniform sampler2D uTex;
// rgb: daylight on the sky picture; a: unused
uniform float4 uTint;
// rgb: the night's own colour
uniform float4 uNight;

half4 main(float2 vUv : TEXCOORD0) : COLOR
{
    half3 c = (half3)tex2D(uTex, vUv).rgb * (half3)uTint.rgb + (half3)uNight.rgb;
    return half4(c, (half)1.0);
}
