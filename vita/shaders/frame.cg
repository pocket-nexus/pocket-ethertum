// What every scene program takes per frame, as one array (uFrame):
//   [0] xyz: towards the sun; w: the sun's light on a face that faces it
//   [1] rgb: the sky's light from straight up; w: 1 / the distance where the world ends, in voxels
//   [2] rgb: the sky's light from straight down; w: seconds
//   [3] rgb: the sky's light from the horizon; w: daylight on the sky picture (0 at night, 1 by day)
// Light is linear and in the reference's units after its camera's exposure (textures.rs, main.rs): a texel t
// (sRGB, taken as t²) under light E shows as display(t² E) (curve_of). Per draw: uOrigin.xyz, the chunk's corner from the
// eye, in voxels. Positions arrive as 1/256 voxel from the corner; the eye is the origin of the view, so the
// matrix uVp has no translation and far chunks keep their precision.

// The reference lights a face with its sky box read in the face's normal: here the sky's light by height, from
// the horizon up to the zenith and down to the nadir (which it nears faster), less the occlusion.
float3 ambient_of(float3 n, float ao, float4 frame[4])
{
    float3 sky = n.y >= 0.0 ? lerp(frame[3].rgb, frame[1].rgb, n.y) : lerp(frame[3].rgb, frame[2].rgb, sqrt(max(-n.y, 0.0)));
    return sky * ao;
}

// The sun's light on a face: N·L by its light.
float sun_of(float3 n, float4 frame[4])
{
    return max(dot(n, frame[0].xyz), 0.0) * frame[0].w;
}

// The reference's tone map and sRGB encoding in one curve (DISPLAY_K in textures.rs).
half3 display(half3 x)
{
    return sqrt(x / (x + (half)0.8));
}

// The same curve folded into a vertex's light for a texel whose t² is a0: the fragment shows t · curve_of(E),
// which is display(t² E) for that texel and near it for the rest of the material. The fragment programs keep
// their one multiply (the curve per fragment cost 7 ms over a canopy). The light then travels at a third, as a
// colour holds 0..1, and is tripled there.
float3 curve_of(float3 e, float3 a0)
{
    return sqrt(e / (a0 * e + 0.8));
}

// The world fades into the sky over the last quarter of the loaded distance: towards the sky picture's own colour
// in the direction of the point, read here from an octahedral map of the sky box (uRing, textures.rs), so far
// terrain dissolves into what is drawn behind it while every draw stays opaque.
float fog_of(float3 p, float4 frame[4])
{
    float d = saturate((length(p) * frame[1].w - 0.75) * 4.0);
    return d * d;
}

float3 sky_toward(float3 p, sampler2D ring, float4 frame[4])
{
    // The octahedral fold needs no unit vector and no angle.
    float2 q = p.xz / (abs(p.x) + abs(p.y) + abs(p.z));
    if (p.y < 0.0)
        q = (1.0 - abs(q.yx)) * float2(q.x >= 0.0 ? 1.0 : -1.0, q.y >= 0.0 ? 1.0 : -1.0);
    float day = frame[3].w;
    return tex2Dlod(ring, float4(q * 0.5 + 0.5, 0.0, 0.0)).rgb * day + float3(0.02, 0.025, 0.05) * (1.0 - day);
}

// The fade's share at p, and in fog the sky's colour behind p by that share. origin.w is 0 for a chunk wholly
// nearer than where the fade starts (scene.rs): its points skip the sky.
float fade_of(float3 p, float4 origin, sampler2D ring, float4 frame[4], out float3 fog)
{
    fog = float3(0.0, 0.0, 0.0);
    float f = 0.0;
    if (origin.w > 0.0) {
        f = fog_of(p, frame);
#ifdef REFLECT
        // The reflection's sky is the sky box turned upside down.
        fog = sky_toward(float3(p.x, -p.y, p.z), ring, frame) * f;
#else
        fog = sky_toward(p, ring, frame) * f;
#endif
    }
    return f;
}

// The reflection pass (REFLECT) draws each point at its mirror image across the sea's plane, y = 0, as the eye sees
// it: p is the point from the eye, eye_y the eye's height.
float3 mirrored(float3 p, float eye_y)
{
#ifdef REFLECT
    return float3(p.x, -p.y - 2.0 * eye_y, p.z);
#else
    return p;
#endif
}
