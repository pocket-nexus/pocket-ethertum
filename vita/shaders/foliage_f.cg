uniform sampler2D uTex;

half4 main(float2 vUv : TEXCOORD0, half4 vLight : COLOR0) : COLOR
{
    half4 t = (half4)tex2D(uTex, vUv);
    // The reference's cut-out: texels under half alpha are not drawn.
    if (t.a < (half)0.5)
        discard;
    half3 c = t.rgb * vLight.rgb * (half)2.0;
    return half4(c, (half)1.0 - vLight.a);
}
