// Faces of water voxels. The reference draws water opaque and mirror-like (deferred, black base colour,
// roughness 0), the normal of every face rippled by four octaves of a normal map at world.xz / 100; three
// octaves are kept. The direction to the eye is normalized here, per vertex: a face is one voxel, and the eye is
// metres away.

void main(
    float3 aPosition,
    float3 aNormal,
    uniform float4x4 uVp,
    uniform float4 uOrigin,
    uniform float4 uWorld,
    uniform float4 uFrame[4],
    uniform sampler2D uRing,
    out float4 oPosition : POSITION,
    out float4 oFog : TEXCOORD3,
    out float4 oScreen : TEXCOORD4,
    out float2 oN0 : TEXCOORD0,
    out float2 oN1 : TEXCOORD1,
    out float2 oN2 : TEXCOORD2,
    out float4 oView : COLOR1,
    out float4 oAir : COLOR0)
{
    float3 local = aPosition * (1.0 / 256.0);
    float3 p = local + uOrigin.xyz;
    oPosition = mul(uVp, float4(p, 1.0));
    // Where the point is on the screen (divided by w in the fragment program): the reflection is read there.
    oScreen = float4((oPosition.x + oPosition.w) * 0.5, (oPosition.w - oPosition.y) * 0.5, 0.0, oPosition.w);
    // uWorld.xz: the chunk corner's world position over 100, wrapped.
    float2 w = uWorld.xz + local.xz * 0.01;
    float t = uFrame[2].w;
    oN0 = w * 1.0 + float2(0.080, 0.059) * t;
    oN1 = w * 2.1 + float2(0.073, -0.062) * t;
    oN2 = w * 7.9 + float2(0.153, 0.138) * t;
    // Towards the eye, carried as a colour (0..1); w: 1 on a face that looks up, 0 on a side face.
    float3 v = normalize(-p);
    oView = float4(v * 0.5 + 0.5, saturate(aNormal.y));
    float3 fog;
    float f = fade_of(p, uOrigin, uRing, uFrame, fog);
    oFog = float4(fog, 1.0 - f);
    // The reference's distance fog, which only its water takes (its terrain and leaves build their material
    // without the fog flag): atmospheric, visibility 1200 m, extinction colour (0.35, 0.5, 0.66), inscattering
    // (110, 230, 255) / 255 and fog colour (0, 0.666, 1), through Bevy's formulas. What it adds, in linear light,
    // and what it leaves of the surface (the mean of its three channels' extinction).
    float d = length(p);
    float3 added = (1.0 - exp(-d * float3(0.0000160, 0.0013212, 0.0024964))) * float3(0.0, 0.4011, 1.0);
    float3 kept = exp(-d * float3(0.001872, 0.001297, 0.000642));
    oAir = float4(added, (kept.x + kept.y + kept.z) * (1.0 / 3.0));
}
